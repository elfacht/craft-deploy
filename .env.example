# ==============================================================
# craft-deploy configuration
# Copy to .env (setup.sh does this) and adjust to your project.
# Only DEPLOY_REPO and DEPLOY_ROOT are required; everything else
# has a sensible default and is optional.
# ==============================================================

# --- Required ---------------------------------------------------

# Git repository URL.
DEPLOY_REPO=""

# Absolute server path to the project root (where this script lives).
DEPLOY_ROOT=""

# --- Git --------------------------------------------------------

# Branch to deploy – optional (default: the repo's default branch).
DEPLOY_BRANCH=""

# Deploy a specific tag/commit/branch – optional. Overrides DEPLOY_BRANCH.
DEPLOY_REF=""

# Shallow clone (faster, less disk). 0 = full clone, 1 = --depth 1.
DEPLOY_SHALLOW=0

# Clone git submodules. 0 = no, 1 = --recurse-submodules.
DEPLOY_SUBMODULES=0

# --- Project layout ---------------------------------------------

# Craft subfolder – optional. Leave empty if Craft lives in the repo root.
DEPLOY_CRAFT_DIR=""

# Assets folder name under web/ – used to build the default linked dirs.
DEPLOY_ASSETS_DIR="uploads"

# --- Shared symlinks --------------------------------------------
# Space-separated paths, relative to ./shared. Each entry X is linked
# at <release>/<craft>/X -> <root>/shared/X. Defaults reproduce the
# classic Craft layout; override to fit your project.
#
# DEPLOY_LINKED_FILES=".env web/.htaccess"
# DEPLOY_LINKED_DIRS="storage web/uploads web/cpresources"

# --- Binaries ---------------------------------------------------

# PHP / Composer binaries – override for version-specific paths.
DEPLOY_PHP_BIN="php"
DEPLOY_COMPOSER_BIN="composer"
DEPLOY_COMPOSER_FLAGS="--no-interaction --prefer-dist --optimize-autoloader"

# --- Craft commands ---------------------------------------------
# Toggle the built-in steps (1 = run, 0 = skip).
DEPLOY_RUN_BACKUP=1
DEPLOY_RUN_MIGRATE=1
DEPLOY_RUN_PROJECT_CONFIG=1

# Extra Craft commands to run after project-config, separated by ';'.
# Example: "clear-caches/all;gc"
DEPLOY_CRAFT_COMMANDS=""

# --- Hooks ------------------------------------------------------
# Optional scripts run with DEPLOY_*, RELEASE_PATH and ROOT_PATH in env.
# "before" runs after symlinks (e.g. asset build); "after" runs once the
# new release is live (e.g. cache warmup, notifications).
DEPLOY_HOOK_BEFORE=""
DEPLOY_HOOK_AFTER=""

# --- Cache / PHP ------------------------------------------------

# Public URL – required only if DEPLOY_CLEAR_OPCACHE=1.
DEPLOY_URL="https://example.com"

# Clear opcache to reset the symlink cache. 0 = disabled, 1 = enabled.
DEPLOY_CLEAR_OPCACHE=0

# PHP restart command if symlinks stay cached – optional.
# May cause a short downtime. Leave empty if not needed.
DEPLOY_RESTART_PHP=""

# --- Retention --------------------------------------------------

# Number of releases to keep.
DEPLOY_KEEP_RELEASES=5

# Number of database backups to keep.
DEPLOY_KEEP_BACKUPS=5
